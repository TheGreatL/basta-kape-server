PORT=8000
FRONTEND_URL=https://your-frontend-domain.com
NODE_ENV=production
DATABASE_URL="mysql://username:password@host:port/database?ssl-mode=REQUIRED&connection_limit=5&pool_timeout=10"
JWT_ACCESS_SECRET=your-super-secret-access-key-here
JWT_REFRESH_SECRET=your-super-secret-refresh-key-here
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# File Storage Config (local or r2)
STORAGE_PROVIDER=r2

# Cloudflare R2 Credentials (Required only when STORAGE_PROVIDER=r2)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_URL=

# EmailJS Service Credentials
EMAILJS_SERVICE_ID=
EMAILJS_PUBLIC_KEY=
EMAILJS_PRIVATE_KEY=
EMAILJS_OTP_TEMPLATE_ID=
EMAILJS_PASSWORD_RESET_TEMPLATE_ID=
