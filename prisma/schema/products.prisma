model ProductCategory {
  id            String       @id @default(uuid())
  name          String
  description   String?
  productTypeId String?
  type          ProductType? @relation(fields: [productTypeId], references: [id])
  products      Product[]

  createdById String?
  createdBy   User?     @relation("ProductCategoryCreatedBy", fields: [createdById], references: [id])
  updatedById String?
  updatedBy   User?     @relation("ProductCategoryUpdatedBy", fields: [updatedById], references: [id])
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  @@index([deletedAt])
  @@index([productTypeId])
}

model ProductType {
  id          String            @id @default(uuid())
  name        String
  description String?
  categories  ProductCategory[]
  products    Product[]

  createdById String?
  createdBy   User?     @relation("ProductTypeCreatedBy", fields: [createdById], references: [id])
  updatedById String?
  updatedBy   User?     @relation("ProductTypeUpdatedBy", fields: [updatedById], references: [id])
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  @@index([deletedAt])
}

model Product {
  id                String              @id @default(uuid())
  name              String
  photo             String?
  description       String?
  preparationType   PreparationType     @default(MADE_TO_ORDER)
  defaultShelfLife  Int? // Default shelf life in minutes (e.g. 1440 = 24h)
  productCategoryId String?
  category          ProductCategory?    @relation(fields: [productCategoryId], references: [id])
  productTypeId     String?
  type              ProductType?        @relation(fields: [productTypeId], references: [id])
  variants          ProductVariant[]
  preparedBatches   PreparedItemBatch[]

  createdById    String?
  createdBy      User?           @relation("ProductCreatedBy", fields: [createdById], references: [id])
  updatedById    String?
  updatedBy      User?           @relation("ProductUpdatedBy", fields: [updatedById], references: [id])
  modifierGroups ModifierGroup[]
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  deletedAt      DateTime?

  @@index([deletedAt])
  @@index([productCategoryId])
  @@index([productTypeId])
  @@index([preparationType])
}

model ProductAttribute {
  id          String                  @id @default(uuid())
  name        String // e.g., "Size", "Milk"
  description String?
  values      ProductAttributeValue[]

  createdById String?
  createdBy   User?     @relation("ProductAttributeCreatedBy", fields: [createdById], references: [id])
  updatedById String?
  updatedBy   User?     @relation("ProductAttributeUpdatedBy", fields: [updatedById], references: [id])
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  @@index([deletedAt])
}

model ProductAttributeValue {
  id                 String                    @id @default(uuid())
  productAttributeId String
  attribute          ProductAttribute          @relation(fields: [productAttributeId], references: [id])
  value              String // e.g., "Small", "Large", "Almond Milk"
  variantAttributes  ProductVariantAttribute[]

  createdById String?
  createdBy   User?     @relation("ProductAttributeValueCreatedBy", fields: [createdById], references: [id])
  updatedById String?
  updatedBy   User?     @relation("ProductAttributeValueUpdatedBy", fields: [updatedById], references: [id])
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  @@index([deletedAt])
  @@index([productAttributeId])
}

model ProductVariant {
  id              String                    @id @default(uuid())
  productId       String
  product         Product                   @relation(fields: [productId], references: [id])
  sku             String?                   @unique
  price           Float                     @default(0)
  attributes      ProductVariantAttribute[]
  recipe          Recipe?
  cartItems       CustomerCart[]
  preparedBatches PreparedItemBatch[]

  createdById String?
  createdBy   User?       @relation("ProductVariantCreatedBy", fields: [createdById], references: [id])
  updatedById String?
  updatedBy   User?       @relation("ProductVariantUpdatedBy", fields: [updatedById], references: [id])
  orderItems  OrderItem[]
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  deletedAt   DateTime?

  @@index([deletedAt])
  @@index([productId])
}

model ProductVariantAttribute {
  id                      String                @id @default(uuid())
  productVariantId        String
  variant                 ProductVariant        @relation(fields: [productVariantId], references: [id])
  productAttributeValueId String
  attributeValue          ProductAttributeValue @relation(fields: [productAttributeValueId], references: [id])

  createdById String?
  createdBy   User?     @relation("ProductVariantAttributeCreatedBy", fields: [createdById], references: [id])
  updatedById String?
  updatedBy   User?     @relation("ProductVariantAttributeUpdatedBy", fields: [updatedById], references: [id])
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  @@index([deletedAt])
  @@index([productVariantId])
  @@index([productAttributeValueId])
}

enum IngredientType {
  INGREDIENT
  PACKAGING_MATERIAL
  SUPPLY
}

enum UnitCategory {
  ALL
  INGREDIENT
  PACKAGING_MATERIAL
  SUPPLY
}

model IngredientUnit {
  id                String             @id @default(uuid())
  name              String // e.g., "Grams", "Milliliters", "Pieces"
  abbreviation      String? // e.g., "g", "ml", "pcs"
  category          UnitCategory       @default(ALL)
  ingredients       Ingredient[]
  recipeIngredients RecipeIngredient[]
  fromConversions   UnitConversion[]   @relation("FromUnitConversions")
  toConversions     UnitConversion[]   @relation("ToUnitConversions")

  createdById String?
  createdBy   User?     @relation("IngredientUnitCreatedBy", fields: [createdById], references: [id])
  updatedById String?
  updatedBy   User?     @relation("IngredientUnitUpdatedBy", fields: [updatedById], references: [id])
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?
}

model Ingredient {
  id               String         @id @default(uuid())
  name             String
  description      String?
  type             IngredientType @default(INGREDIENT)
  ingredientUnitId String
  defaultUnit      IngredientUnit @relation(fields: [ingredientUnitId], references: [id])
  reorderPoint     Float          @default(0)

  batches            IngredientBatch[]
  inventories        IngredientInventory[]
  recipeIngredients  RecipeIngredient[]
  adjustments        InventoryAdjustment[]
  purchaseOrderItems PurchaseOrderItem[]
  suppliers          SupplierIngredient[]
  unitConversions    UnitConversion[]

  createdById String?
  createdBy   User?     @relation("IngredientCreatedBy", fields: [createdById], references: [id])
  updatedById String?
  updatedBy   User?     @relation("IngredientUpdatedBy", fields: [updatedById], references: [id])
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?
}

model Supplier {
  id             String               @id @default(uuid())
  name           String
  address        String?
  notes          String?
  contactPerson  String?
  contactNumber  String?
  batches        IngredientBatch[]
  purchaseOrders PurchaseOrder[]
  ingredients    SupplierIngredient[]

  createdById String?
  createdBy   User?     @relation("SupplierCreatedBy", fields: [createdById], references: [id])
  updatedById String?
  updatedBy   User?     @relation("SupplierUpdatedBy", fields: [updatedById], references: [id])
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?
}

model SupplierIngredient {
  id           String     @id @default(uuid())
  supplierId   String
  supplier     Supplier   @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  ingredientId String
  ingredient   Ingredient @relation(fields: [ingredientId], references: [id], onDelete: Cascade)
  unitCost     Float?     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([supplierId, ingredientId])
  @@index([supplierId])
  @@index([ingredientId])
}

model IngredientBatch {
  id               String     @id @default(uuid())
  ingredientId     String
  ingredient       Ingredient @relation(fields: [ingredientId], references: [id])
  supplierId       String?
  supplier         Supplier?  @relation(fields: [supplierId], references: [id])
  receivedAt       DateTime   @default(now())
  expiryDate       DateTime?
  quantityReceived Float      @default(0)
  currentQuantity  Float      @default(0)
  unitCost         Float      @default(0)
  totalCost        Float      @default(0)
  batchNumber      String?

  purchaseOrderId String?
  purchaseOrder   PurchaseOrder? @relation(fields: [purchaseOrderId], references: [id])

  transactions StockTransaction[]

  createdById String?
  createdBy   User?     @relation("IngredientBatchCreatedBy", fields: [createdById], references: [id])
  updatedById String?
  updatedBy   User?     @relation("IngredientBatchUpdatedBy", fields: [updatedById], references: [id])
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  @@index([deletedAt])
  @@index([ingredientId])
  @@index([expiryDate])
}

enum TransactionType {
  DELIVERY
  SALE
  WASTE
  SPOILED
  EXPIRED
  THEFT
  PROMOTIONAL_USE
  PHYSICAL_COUNT_CORRECTION
}

model StockTransaction {
  id             String          @id @default(uuid())
  batchId        String
  batch          IngredientBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)
  quantityChange Float
  type           TransactionType
  reason         String?

  createdById String?
  createdBy   User?    @relation("StockTransactionCreatedBy", fields: [createdById], references: [id])
  createdAt   DateTime @default(now())

  @@index([batchId])
}

model IngredientInventory {
  id                String          @id @default(uuid())
  ingredientId      String
  ingredient        Ingredient      @relation(fields: [ingredientId], references: [id])
  currentQuantity   Float           @default(0)
  lastPhysicalCount DateTime?
  status            InventoryStatus @default(SAFE)

  createdById String?
  createdBy   User?     @relation("IngredientInventoryCreatedBy", fields: [createdById], references: [id])
  updatedById String?
  updatedBy   User?     @relation("IngredientInventoryUpdatedBy", fields: [updatedById], references: [id])
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?
}

model Recipe {
  id               String             @id @default(uuid())
  name             String
  description      String?
  productVariantId String?            @unique
  productVariant   ProductVariant?    @relation(fields: [productVariantId], references: [id])
  modifierOptionId String?            @unique
  modifierOption   ModifierOption?    @relation(fields: [modifierOptionId], references: [id])
  ingredients      RecipeIngredient[]

  createdById String?
  createdBy   User?     @relation("RecipeCreatedBy", fields: [createdById], references: [id])
  updatedById String?
  updatedBy   User?     @relation("RecipeUpdatedBy", fields: [updatedById], references: [id])
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  @@index([deletedAt])
}

model RecipeIngredient {
  id               String         @id @default(uuid())
  recipeId         String
  recipe           Recipe         @relation(fields: [recipeId], references: [id])
  ingredientId     String
  ingredient       Ingredient     @relation(fields: [ingredientId], references: [id])
  quantity         Float          @default(0)
  ingredientUnitId String
  unit             IngredientUnit @relation(fields: [ingredientUnitId], references: [id])

  createdById String?
  createdBy   User?     @relation("RecipeIngredientCreatedBy", fields: [createdById], references: [id])
  updatedById String?
  updatedBy   User?     @relation("RecipeIngredientUpdatedBy", fields: [updatedById], references: [id])
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  @@index([deletedAt])
  @@index([recipeId])
  @@index([ingredientId])
}

enum InventoryStatus {
  SAFE
  CRITICAL
  OUT_OF_STOCK
}

enum AdjustmentType {
  WASTE
  SPOILED
  EXPIRED
  THEFT
  PROMOTIONAL_USE
  PHYSICAL_COUNT_DISCREPANCY
}

model InventoryAdjustment {
  id           String         @id @default(uuid())
  ingredientId String
  ingredient   Ingredient     @relation(fields: [ingredientId], references: [id])
  quantity     Float // Negative for waste/spoilage, positive for correction
  type         AdjustmentType
  reason       String?

  createdById String?
  createdBy   User?     @relation("InventoryAdjustmentCreatedBy", fields: [createdById], references: [id])
  updatedById String?
  updatedBy   User?     @relation("InventoryAdjustmentUpdatedBy", fields: [updatedById], references: [id])
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?
}

enum PurchaseOrderStatus {
  DRAFT
  SENT
  RECEIVED
  CANCELLED
}

model PurchaseOrder {
  id          String              @id @default(uuid())
  poNumber    String              @unique // E.g., PO-2026-0001
  status      PurchaseOrderStatus @default(DRAFT)
  notes       String?
  totalAmount Float               @default(0)

  supplierId String
  supplier   Supplier @relation(fields: [supplierId], references: [id])

  createdById String
  createdBy   User   @relation("PurchaseOrderCreatedBy", fields: [createdById], references: [id])

  items   PurchaseOrderItem[]
  batches IngredientBatch[]

  orderedAt  DateTime?
  receivedAt DateTime?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
}

model PurchaseOrderItem {
  id              String        @id @default(uuid())
  purchaseOrderId String
  purchaseOrder   PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  ingredientId    String
  ingredient      Ingredient    @relation(fields: [ingredientId], references: [id])

  quantity  Float @default(0)
  unitCost  Float @default(0)
  totalCost Float @default(0)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
}

enum PreparationType {
  MADE_TO_ORDER
  PREPARED_DISPLAY
}

enum PreparedBatchStatus {
  FRESH
  NEAR_EXPIRY
  EXPIRED
  DEPLETED
  DISPOSED
}

enum PreparedAdjustmentType {
  SALE
  EXPIRED
  SPOILED
  WASTE
  SAMPLING
  DISPOSED
  CORRECTION
}

model PreparedItemBatch {
  id               String              @id @default(uuid())
  productVariantId String
  productVariant   ProductVariant      @relation(fields: [productVariantId], references: [id])
  productId        String
  product          Product             @relation(fields: [productId], references: [id])
  batchNumber      String              @unique
  quantityPrepared Float               @default(0)
  currentQuantity  Float               @default(0)
  preparedAt       DateTime            @default(now())
  shelfLifeMinutes Int                 @default(1440)
  expiresAt        DateTime
  status           PreparedBatchStatus @default(FRESH)
  notes            String?

  transactions PreparedItemTransaction[]

  createdById String?
  createdBy   User?     @relation("PreparedBatchCreatedBy", fields: [createdById], references: [id])
  updatedById String?
  updatedBy   User?     @relation("PreparedBatchUpdatedBy", fields: [updatedById], references: [id])
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  @@index([productVariantId])
  @@index([productId])
  @@index([expiresAt])
  @@index([status])
  @@index([deletedAt])
}

model PreparedItemTransaction {
  id             String                 @id @default(uuid())
  batchId        String
  batch          PreparedItemBatch      @relation(fields: [batchId], references: [id], onDelete: Cascade)
  quantityChange Float
  type           PreparedAdjustmentType
  reason         String?

  orderId String?
  order   Order?  @relation(fields: [orderId], references: [id])

  createdById String?
  createdBy   User?    @relation("PreparedItemTransactionCreatedBy", fields: [createdById], references: [id])
  createdAt   DateTime @default(now())

  @@index([batchId])
  @@index([orderId])
}

model UnitConversion {
  id         String         @id @default(uuid())
  fromUnitId String
  fromUnit   IngredientUnit @relation("FromUnitConversions", fields: [fromUnitId], references: [id], onDelete: Cascade)
  toUnitId   String
  toUnit     IngredientUnit @relation("ToUnitConversions", fields: [toUnitId], references: [id], onDelete: Cascade)
  factor     Float

  ingredientId String?
  ingredient   Ingredient? @relation(fields: [ingredientId], references: [id], onDelete: Cascade)

  createdById String?
  createdBy   User?     @relation("UnitConversionCreatedBy", fields: [createdById], references: [id])
  updatedById String?
  updatedBy   User?     @relation("UnitConversionUpdatedBy", fields: [updatedById], references: [id])
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  @@index([fromUnitId])
  @@index([toUnitId])
  @@index([ingredientId])
  @@index([deletedAt])
}
